{
  "name": "@trebired/tasks",
  "version": "1.1.5",
  "description": "Durable background task host for Bun with persisted task records, Postgres and SQLite storage, progress, retries, dedupe, recovery, and pluggable executors.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "name": "trebired"
    }
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "demo": "bun run examples/postgres_child_process.ts",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run verify:pack",
    "typecheck": "tsc --noEmit",
    "verify:pack": "bun ./scripts/verify-pack.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.2.5",
    "@package/result": "npm:@trebired/result@^1.1.1",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^4.8.0",
    "@types/bun": "^1.3.4",
    "@types/node": "^24.10.1",
    "pg": "^8.16.3",
    "typescript": "^6.0.2"
  },
  "keywords": [
    "tasks",
    "queue",
    "jobs",
    "background-jobs",
    "postgres",
    "sqlite",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/tasks"
  },
  "homepage": "https://github.com/Trebired/tasks#readme",
  "bugs": {
    "url": "https://github.com/Trebired/tasks/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
